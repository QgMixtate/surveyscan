@@@SURVEY:sshd_effective@@@
port 22
permitrootlogin yes
permitemptypasswords no
maxauthtries 6
x11forwarding yes
clientaliveinterval 0
clientalivecountmax 3
ciphers chacha20-poly1305@openssh.com,aes128-ctr,aes192-ctr,aes256-ctr,aes128-gcm@openssh.com,aes256-gcm@openssh.com,aes128-cbc

@@@SURVEY:sshd_config@@@

@@@SURVEY:login_defs@@@
PASS_MAX_DAYS	99999
PASS_MIN_DAYS	0
PASS_WARN_AGE	7
UID_MIN	1000
ENCRYPT_METHOD SHA512

@@@SURVEY:pwquality@@@

@@@SURVEY:faillock@@@

@@@SURVEY:pam@@@
### /etc/pam.d/common-password
password	[success=1 default=ignore]	pam_unix.so obscure sha512
password	requisite	pam_deny.so
password	required	pam_permit.so
### /etc/pam.d/common-auth
auth	required	pam_tally.so onerr=fail deny=8 unlock_time=60
auth	[success=1 default=ignore]	pam_unix.so nullok
auth	requisite	pam_deny.so
### /etc/pam.d/su
auth       sufficient pam_rootok.so
session    required   pam_env.so readenv=1

@@@SURVEY:passwd@@@
root:0:/bin/bash
daemon:1:/usr/sbin/nologin
backup:0:/bin/sh
admin:1000:/bin/bash
guest:1001:/bin/bash
postgres:113:/bin/bash

@@@SURVEY:shadow_empty@@@

@@@SURVEY:cmdline@@@
BOOT_IMAGE=(hd0,gpt2)/vmlinuz-6.1.52-1.el7.3.x86_64 root=/dev/mapper/ro-root ro init_on_alloc=1 slab_nomerge vsyscall=none randomize_kstack_offset=1 debugfs=off

@@@SURVEY:sshd_effective@@@
port 22
permitrootlogin no
permitemptypasswords no
maxauthtries 3
x11forwarding no
clientaliveinterval 300
clientalivecountmax 0
ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr

@@@SURVEY:sshd_config@@@

@@@SURVEY:login_defs@@@
PASS_MAX_DAYS	90
PASS_MIN_DAYS	1
PASS_WARN_AGE	14

@@@SURVEY:pwquality@@@
minlen = 10
minclass = 3

@@@SURVEY:faillock@@@
deny = 5
unlock_time = 900

@@@SURVEY:pam@@@
### /etc/pam.d/system-auth
auth        required      pam_faillock.so preauth silent
auth        sufficient    pam_unix.so
auth        [default=die] pam_faillock.so authfail
password    requisite     pam_pwquality.so local_users_only retry=3
password    sufficient    pam_unix.so sha512 shadow use_authtok
### /etc/pam.d/su
auth            sufficient      pam_rootok.so
auth            required        pam_wheel.so use_uid

@@@SURVEY:passwd@@@
root:0:/bin/bash
bin:1:/sbin/nologin
postgres:26:/bin/bash
dbadmin:1000:/bin/bash

@@@SURVEY:shadow_empty@@@

@@@SURVEY:sudoers_nopasswd@@@


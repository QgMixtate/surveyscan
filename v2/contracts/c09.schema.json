{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surveyscan.invalid/contracts/C09/1.0",
  "$defs": {
    "Version": {
      "type": "object",
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": false
    },
    "Origin": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_kind": {
          "enum": [
            "agent",
            "collector",
            "portable"
          ]
        },
        "generation_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "source_id",
        "source_kind",
        "generation_id"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_kind": {
          "enum": [
            "agent",
            "collector",
            "portable"
          ]
        },
        "site_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "pending",
            "active",
            "revoked",
            "disabled"
          ]
        },
        "last_contact_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_successful_inventory_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tenant_id",
        "source_id",
        "source_kind",
        "site_id",
        "state",
        "last_contact_at",
        "last_successful_inventory_at"
      ],
      "additionalProperties": false
    },
    "Asset": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "asset_uid": {
          "type": "string",
          "format": "uuid"
        },
        "site_id": {
          "type": "string",
          "format": "uuid"
        },
        "business_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "maxLength": 20
        },
        "business": {
          "$ref": "#/$defs/BusinessFields"
        },
        "observed_hostname": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "observed_os": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "last_inventory_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "accountable_subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "section_states": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "enum": [
                  "identity",
                  "os",
                  "network"
                ]
              },
              "status": {
                "enum": [
                  "ok",
                  "partial",
                  "unavailable",
                  "unsupported",
                  "not_requested",
                  "unknown"
                ]
              }
            },
            "required": [
              "name",
              "status"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 3
        }
      },
      "required": [
        "tenant_id",
        "asset_uid",
        "site_id",
        "business_revision",
        "business",
        "observed_hostname",
        "observed_os",
        "last_inventory_at",
        "freshness",
        "accountable_subject_id",
        "section_states"
      ],
      "additionalProperties": false
    },
    "BusinessFields": {
      "type": "object",
      "properties": {
        "display_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "criticality": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "display_name",
        "purpose",
        "criticality",
        "tags"
      ],
      "additionalProperties": false
    },
    "SubjectSummary": {
      "type": "object",
      "properties": {
        "subject_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "enum": [
            "team",
            "person"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "subject_id",
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "FactEvidence": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "source_sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$",
          "maxLength": 20
        },
        "collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "clock_quality": {
          "enum": [
            "trusted",
            "estimated",
            "unknown",
            "skewed"
          ]
        }
      },
      "required": [
        "observation_id",
        "origin",
        "source_sequence",
        "collected_at",
        "clock_quality"
      ],
      "additionalProperties": false
    },
    "CurrentFact": {
      "type": "object",
      "properties": {
        "section": {
          "enum": [
            "identity",
            "os",
            "network"
          ]
        },
        "key": {
          "type": "string",
          "maxLength": 512
        },
        "value": {
          "type": "string",
          "maxLength": 65536
        },
        "interface_name": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/FactEvidence"
        }
      },
      "required": [
        "section",
        "key",
        "value",
        "interface_name",
        "evidence"
      ],
      "additionalProperties": false
    },
    "SectionDetail": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "identity",
            "os",
            "network"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "partial",
            "unavailable",
            "unsupported",
            "not_requested",
            "unknown"
          ]
        },
        "clock_uncertain": {
          "type": "boolean"
        },
        "last_attempt": {
          "oneOf": [
            {
              "$ref": "#/$defs/FactEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_success": {
          "oneOf": [
            {
              "$ref": "#/$defs/FactEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "status",
        "clock_uncertain",
        "last_attempt",
        "last_success"
      ],
      "additionalProperties": false
    },
    "SourceSummary": {
      "type": "object",
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_kind": {
          "enum": [
            "agent",
            "collector",
            "portable"
          ]
        },
        "site_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "pending",
            "active",
            "revoked",
            "disabled"
          ]
        },
        "last_contact_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_successful_inventory_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation_id": {
          "type": "string",
          "format": "uuid"
        },
        "contact_status": {
          "enum": [
            "recently_seen",
            "stale",
            "unknown"
          ]
        }
      },
      "required": [
        "tenant_id",
        "source_id",
        "source_kind",
        "site_id",
        "state",
        "last_contact_at",
        "last_successful_inventory_at",
        "generation_id",
        "contact_status"
      ],
      "additionalProperties": false
    },
    "InventoryDetail": {
      "type": "object",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/Version"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "asset_uid": {
          "type": "string",
          "format": "uuid"
        },
        "asset": {
          "$ref": "#/$defs/Asset"
        },
        "accountable": {
          "$ref": "#/$defs/SubjectSummary"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CurrentFact"
          },
          "maxItems": 2048
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SectionDetail"
          },
          "maxItems": 3
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceSummary"
          },
          "maxItems": 2054
        }
      },
      "required": [
        "schema_version",
        "tenant_id",
        "asset_uid",
        "asset",
        "accountable",
        "facts",
        "sections",
        "sources"
      ],
      "additionalProperties": false
    }
  }
}

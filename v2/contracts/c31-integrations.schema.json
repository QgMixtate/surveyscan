{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:surveyscan:c31:integrations:1:0",
 "title": "Интеграции (C31, ADR C31-integrations): синхронизация оргструктуры из каталога, CSV активов",
 "$defs": {
  "SyncRun": {
   "type": "object",
   "properties": {
    "run_id": {
     "type": "string",
     "format": "uuid"
    },
    "mode": {
     "enum": [
      "full",
      "incremental"
     ]
    },
    "started_at": {
     "type": "string",
     "format": "date-time"
    },
    "finished_at": {
     "type": "string",
     "format": "date-time"
    },
    "status": {
     "enum": [
      "succeeded",
      "failed"
     ]
    },
    "counters": {
     "type": "object",
     "properties": {
      "people_seen": {
       "type": "integer",
       "minimum": 0
      },
      "teams_seen": {
       "type": "integer",
       "minimum": 0
      },
      "created": {
       "type": "integer",
       "minimum": 0
      },
      "updated": {
       "type": "integer",
       "minimum": 0
      },
      "deactivated": {
       "type": "integer",
       "minimum": 0
      },
      "reactivated": {
       "type": "integer",
       "minimum": 0
      },
      "members_added": {
       "type": "integer",
       "minimum": 0
      },
      "members_removed": {
       "type": "integer",
       "minimum": 0
      },
      "logins_linked": {
       "type": "integer",
       "minimum": 0
      },
      "assignments_reassigned": {
       "type": "integer",
       "minimum": 0
      },
      "problems": {
       "type": "array",
       "maxItems": 50,
       "items": {
        "type": "string"
       }
      }
     },
     "additionalProperties": false
    },
    "error": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 1024
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "run_id",
    "mode",
    "started_at",
    "finished_at",
    "status",
    "counters",
    "error"
   ],
   "additionalProperties": false
  },
  "DirectorySyncStatus": {
   "type": "object",
   "properties": {
    "tenant_id": {
     "type": "string",
     "format": "uuid"
    },
    "configured": {
     "type": "boolean"
    },
    "source": {
     "oneOf": [
      {
       "type": "string",
       "pattern": "^ldaps?://"
      },
      {
       "type": "null"
      }
     ]
    },
    "interval_minutes": {
     "type": "integer",
     "minimum": 0
    },
    "full_sync_hours": {
     "type": "integer",
     "minimum": 0
    },
    "teams_enabled": {
     "type": "boolean"
    },
    "runs": {
     "type": "array",
     "maxItems": 20,
     "items": {
      "$ref": "#/$defs/SyncRun"
     }
    }
   },
   "required": [
    "tenant_id",
    "configured",
    "source",
    "interval_minutes",
    "full_sync_hours",
    "teams_enabled",
    "runs"
   ],
   "additionalProperties": false
  },
  "DirectorySyncRequest": {
   "type": "object",
   "properties": {
    "mode": {
     "enum": [
      "full",
      "auto"
     ]
    }
   },
   "required": [
    "mode"
   ],
   "additionalProperties": false
  },
  "CSVRowResult": {
   "type": "object",
   "properties": {
    "line": {
     "type": "integer",
     "minimum": 1
    },
    "asset_uid": {
     "type": "string",
     "maxLength": 64
    },
    "status": {
     "enum": [
      "applied",
      "unchanged",
      "stale_revision",
      "not_found",
      "invalid"
     ]
    },
    "field": {
     "oneOf": [
      {
       "enum": [
        "asset_uid",
        "business_revision",
        "display_name",
        "purpose",
        "criticality",
        "tags",
        "asset_class",
        "business"
       ]
      },
      {
       "type": "null"
      }
     ]
    },
    "business_revision": {
     "oneOf": [
      {
       "type": "string",
       "pattern": "^[1-9][0-9]{0,19}$"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "line",
    "asset_uid",
    "status",
    "field",
    "business_revision"
   ],
   "additionalProperties": false
  },
  "CSVImportResult": {
   "type": "object",
   "properties": {
    "tenant_id": {
     "type": "string",
     "format": "uuid"
    },
    "dry_run": {
     "type": "boolean"
    },
    "format": {
     "const": "#surveyscan-assets-csv;v1"
    },
    "counts": {
     "type": "object",
     "properties": {
      "applied": {
       "type": "integer",
       "minimum": 0
      },
      "unchanged": {
       "type": "integer",
       "minimum": 0
      },
      "stale_revision": {
       "type": "integer",
       "minimum": 0
      },
      "not_found": {
       "type": "integer",
       "minimum": 0
      },
      "invalid": {
       "type": "integer",
       "minimum": 0
      }
     },
     "required": [
      "applied",
      "unchanged",
      "stale_revision",
      "not_found",
      "invalid"
     ],
     "additionalProperties": false
    },
    "results": {
     "type": "array",
     "maxItems": 10000,
     "items": {
      "$ref": "#/$defs/CSVRowResult"
     }
    }
   },
   "required": [
    "tenant_id",
    "dry_run",
    "format",
    "counts",
    "results"
   ],
   "additionalProperties": false
  },
  "WebhookSubscription": {
   "type": "object",
   "properties": {
    "subscription_id": {
     "type": "string",
     "format": "uuid"
    },
    "url": {
     "type": "string",
     "pattern": "^https?://",
     "maxLength": 2048
    },
    "event_types": {
     "type": "array",
     "minItems": 1,
     "maxItems": 16,
     "uniqueItems": true,
     "items": {
      "enum": [
       "asset.created.v1",
       "asset.facts_changed.v1",
       "responsibility.assigned.v1",
       "observation.recorded.v1",
       "source.contact_updated.v1",
       "source.profile_updated.v1"
      ]
     }
    },
    "active": {
     "type": "boolean"
    },
    "revision": {
     "type": "string",
     "pattern": "^[1-9][0-9]{0,19}$"
    },
    "created_at": {
     "type": "string",
     "format": "date-time"
    },
    "pending": {
     "type": "integer",
     "minimum": 0
    },
    "delivered": {
     "type": "integer",
     "minimum": 0
    },
    "dead": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "subscription_id",
    "url",
    "event_types",
    "active",
    "revision",
    "created_at",
    "pending",
    "delivered",
    "dead"
   ],
   "additionalProperties": false
  },
  "WebhookList": {
   "type": "object",
   "properties": {
    "tenant_id": {
     "type": "string",
     "format": "uuid"
    },
    "enabled": {
     "type": "boolean"
    },
    "event_types": {
     "type": "array",
     "items": {
      "enum": [
       "asset.created.v1",
       "asset.facts_changed.v1",
       "responsibility.assigned.v1",
       "observation.recorded.v1",
       "source.contact_updated.v1",
       "source.profile_updated.v1"
      ]
     }
    },
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "#/$defs/WebhookSubscription"
     }
    },
    "can_enable": {
     "type": "boolean"
    }
   },
   "required": [
    "tenant_id",
    "enabled",
    "event_types",
    "items",
    "can_enable"
   ],
   "additionalProperties": false
  },
  "WebhookCreated": {
   "type": "object",
   "properties": {
    "subscription": {
     "$ref": "#/$defs/WebhookSubscription"
    },
    "signing_secret": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]{43}$"
    }
   },
   "required": [
    "subscription",
    "signing_secret"
   ],
   "additionalProperties": false
  },
  "WebhookDelivery": {
   "type": "object",
   "properties": {
    "event_id": {
     "type": "string",
     "format": "uuid"
    },
    "event_type": {
     "enum": [
      "asset.created.v1",
      "asset.facts_changed.v1",
      "responsibility.assigned.v1",
      "observation.recorded.v1",
      "source.contact_updated.v1",
      "source.profile_updated.v1"
     ]
    },
    "occurred_at": {
     "type": "string",
     "format": "date-time"
    },
    "state": {
     "enum": [
      "pending",
      "delivered",
      "dead"
     ]
    },
    "attempts": {
     "type": "integer",
     "minimum": 0
    },
    "next_attempt_at": {
     "oneOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    },
    "last_status": {
     "oneOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ]
    },
    "last_error": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 512
      },
      {
       "type": "null"
      }
     ]
    },
    "delivered_at": {
     "oneOf": [
      {
       "type": "string",
       "format": "date-time"
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "state",
    "attempts",
    "next_attempt_at",
    "last_status",
    "last_error",
    "delivered_at"
   ],
   "additionalProperties": false
  },
  "WebhookDeliveryPage": {
   "type": "object",
   "properties": {
    "tenant_id": {
     "type": "string",
     "format": "uuid"
    },
    "subscription_id": {
     "type": "string",
     "format": "uuid"
    },
    "items": {
     "type": "array",
     "maxItems": 100,
     "items": {
      "$ref": "#/$defs/WebhookDelivery"
     }
    }
   },
   "required": [
    "tenant_id",
    "subscription_id",
    "items"
   ],
   "additionalProperties": false
  },
  "WebhookPayload": {
   "description": "Тело POST получателю. Заголовки: X-SurveyScan-Event-Id (отбрасывать повторы), X-SurveyScan-Timestamp (секунды Unix), X-SurveyScan-Signature: v1=hex(HMAC-SHA256(secret, timestamp + '.' + body)), где secret — base64url signing_secret.",
   "type": "object",
   "properties": {
    "schema": {
     "const": "surveyscan-webhook-v1"
    },
    "event_id": {
     "type": "string",
     "format": "uuid"
    },
    "event_type": {
     "enum": [
      "asset.created.v1",
      "asset.facts_changed.v1",
      "responsibility.assigned.v1",
      "observation.recorded.v1",
      "source.contact_updated.v1",
      "source.profile_updated.v1"
     ]
    },
    "tenant_id": {
     "type": "string",
     "format": "uuid"
    },
    "occurred_at": {
     "type": "string",
     "format": "date-time"
    },
    "aggregate": {
     "type": "object",
     "properties": {
      "type": {
       "type": "string"
      },
      "id": {
       "type": "string",
       "format": "uuid"
      },
      "version": {
       "type": "string",
       "pattern": "^[1-9][0-9]{0,19}$"
      }
     },
     "required": [
      "type",
      "id",
      "version"
     ],
     "additionalProperties": false
    },
    "data": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   },
   "required": [
    "schema",
    "event_id",
    "event_type",
    "tenant_id",
    "occurred_at",
    "aggregate",
    "data"
   ],
   "additionalProperties": false
  },
  "DirectoryWebSettings": {
   "type": "object",
   "properties": {
    "url": {
     "type": "string",
     "pattern": "^ldaps?://",
     "maxLength": 512
    },
    "base_dn": {
     "type": "string",
     "minLength": 1,
     "maxLength": 1024
    },
    "bind_dn": {
     "type": "string",
     "minLength": 1,
     "maxLength": 1024
    },
    "user_filter": {
     "type": "string",
     "maxLength": 2048
    },
    "group_filter": {
     "type": "string",
     "maxLength": 2048
    },
    "guid_attribute": {
     "type": "string",
     "maxLength": 64
    },
    "login_attribute": {
     "type": "string",
     "maxLength": 64
    },
    "changed_attribute": {
     "type": "string",
     "maxLength": 64
    },
    "interval_minutes": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1440
    },
    "full_sync_hours": {
     "type": "integer",
     "minimum": 0,
     "maximum": 720
    },
    "ca_certificate_pem": {
     "type": "string",
     "maxLength": 32768
    },
    "tls_server_name": {
     "type": "string",
     "maxLength": 253,
     "pattern": "^[A-Za-z0-9.-]+$",
     "description": "Имя в сертификате контроллера, если адрес задан IP"
    }
   },
   "required": [
    "url",
    "base_dn",
    "bind_dn"
   ],
   "additionalProperties": false
  },
  "DirectorySettingsView": {
   "type": "object",
   "properties": {
    "tenant_id": {
     "type": "string",
     "format": "uuid"
    },
    "source": {
     "enum": [
      "none",
      "web",
      "config"
     ]
    },
    "secrets_available": {
     "type": "boolean"
    },
    "revision": {
     "oneOf": [
      {
       "type": "string",
       "pattern": "^[1-9][0-9]{0,19}$"
      },
      {
       "type": "null"
      }
     ]
    },
    "settings": {
     "oneOf": [
      {
       "$ref": "#/$defs/DirectoryWebSettings"
      },
      {
       "type": "null"
      }
     ]
    },
    "password_set": {
     "type": "boolean"
    }
   },
   "required": [
    "tenant_id",
    "source",
    "secrets_available",
    "revision",
    "settings",
    "password_set"
   ],
   "additionalProperties": false,
   "description": "Пароль служебной учётки никогда не возвращается — только признак password_set."
  },
  "DirectorySettingsUpdate": {
   "type": "object",
   "properties": {
    "revision": {
     "type": "string",
     "maxLength": 20
    },
    "settings": {
     "$ref": "#/$defs/DirectoryWebSettings"
    },
    "password": {
     "type": "string",
     "minLength": 1,
     "maxLength": 1024
    }
   },
   "required": [
    "revision",
    "settings"
   ],
   "additionalProperties": false
  },
  "DirectoryTestResult": {
   "type": "object",
   "properties": {
    "ok": {
     "type": "boolean"
    },
    "people_found": {
     "type": "integer",
     "minimum": 0
    },
    "teams_found": {
     "type": "integer",
     "minimum": 0
    },
    "error": {
     "oneOf": [
      {
       "type": "string",
       "maxLength": 2048
      },
      {
       "type": "null"
      }
     ]
    }
   },
   "required": [
    "ok",
    "people_found",
    "teams_found",
    "error"
   ],
   "additionalProperties": false
  }
 }
}

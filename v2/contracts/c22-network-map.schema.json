{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:surveyscan:c22:network-map:1:0",
  "title": "Ручной слой схемы сети (GET/PUT /api/v1/topology/map, C22.04)",
  "description": "Общий для тенанта документ поверх наблюдаемой схемы: раскладка, ручные устройства, связи, группы, подписи, переопределения типа/имени. PUT принимает {revision, document}; revision \"0\" — документа ещё нет; несовпадение ревизии — 412.",
  "type": "object",
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "document": {
      "$ref": "#/$defs/Document"
    }
  },
  "required": [
    "revision",
    "updated_at",
    "updated_by",
    "document"
  ],
  "additionalProperties": false,
  "$defs": {
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        },
        "y": {
          "type": "number",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "DeviceType": {
      "enum": [
        "server",
        "workstation",
        "virtual_machine",
        "hypervisor",
        "switch",
        "router",
        "firewall",
        "access_point",
        "printer",
        "storage",
        "cloud",
        "other"
      ]
    },
    "Document": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "object",
          "maxProperties": 20000,
          "propertyNames": {
            "type": "string",
            "pattern": "^(host|subnet|gw|m):[A-Za-z0-9:._/%-]{1,160}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Point"
          }
        },
        "devices": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^m:[A-Za-z0-9_-]{1,64}$"
              },
              "type": {
                "$ref": "#/$defs/DeviceType"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "note": {
                "type": "string",
                "minLength": 0,
                "maxLength": 1000
              },
              "address": {
                "type": "string",
                "minLength": 0,
                "maxLength": 120
              },
              "at": {
                "$ref": "#/$defs/Point"
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "at"
            ],
            "additionalProperties": false
          }
        },
        "links": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^m:[A-Za-z0-9_-]{1,64}$"
              },
              "a": {
                "type": "string",
                "pattern": "^(host|subnet|gw|m):[A-Za-z0-9:._/%-]{1,160}$"
              },
              "b": {
                "type": "string",
                "pattern": "^(host|subnet|gw|m):[A-Za-z0-9:._/%-]{1,160}$"
              },
              "kind": {
                "enum": [
                  "copper",
                  "fiber",
                  "wireless",
                  "trunk",
                  "vpn",
                  "virtual",
                  "logical"
                ]
              },
              "port_a": {
                "type": "string",
                "minLength": 0,
                "maxLength": 64
              },
              "port_b": {
                "type": "string",
                "minLength": 0,
                "maxLength": 64
              },
              "label": {
                "type": "string",
                "minLength": 0,
                "maxLength": 120
              }
            },
            "required": [
              "id",
              "a",
              "b",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "groups": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^m:[A-Za-z0-9_-]{1,64}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "color": {
                "enum": [
                  "green",
                  "blue",
                  "amber",
                  "red",
                  "gray",
                  "violet"
                ]
              },
              "at": {
                "$ref": "#/$defs/Point"
              },
              "width": {
                "type": "number",
                "minimum": 80,
                "maximum": 20000
              },
              "height": {
                "type": "number",
                "minimum": 60,
                "maximum": 20000
              }
            },
            "required": [
              "id",
              "label",
              "color",
              "at",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^m:[A-Za-z0-9_-]{1,64}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "at": {
                "$ref": "#/$defs/Point"
              }
            },
            "required": [
              "id",
              "text",
              "at"
            ],
            "additionalProperties": false
          }
        },
        "overrides": {
          "type": "object",
          "maxProperties": 20000,
          "propertyNames": {
            "type": "string",
            "pattern": "^(host|subnet|gw|m):[A-Za-z0-9:._/%-]{1,160}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "type": {
                "$ref": "#/$defs/DeviceType"
              },
              "label": {
                "type": "string",
                "minLength": 0,
                "maxLength": 120
              },
              "hidden": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          }
        }
      },
      "required": [
        "positions",
        "devices",
        "links",
        "groups",
        "notes",
        "overrides"
      ],
      "additionalProperties": false
    }
  }
}

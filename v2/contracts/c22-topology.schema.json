{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:surveyscan:c22:topology:1:0",
  "title": "Схема сети L3 из наблюдаемых фактов (GET /api/v1/topology)",
  "type": "object",
  "properties": {
    "tenant_id": {"type": "string", "format": "uuid"},
    "generated_at": {"type": "string", "format": "date-time"},
    "nodes": {"type": "array", "maxItems": 20000, "items": {"$ref": "#/$defs/Node"}},
    "links": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/Link"}},
    "truncated": {"type": "boolean"},
    "hosts_with_network_facts": {"type": "integer", "minimum": 0}
  },
  "required": ["tenant_id", "generated_at", "nodes", "links", "truncated", "hosts_with_network_facts"],
  "additionalProperties": false,
  "$defs": {
    "Node": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "maxLength": 200},
        "kind": {"enum": ["host", "subnet", "gateway"]},
        "label": {"type": "string", "maxLength": 300},
        "detail": {"type": "string", "maxLength": 300},
        "asset_uid": {"type": "string", "format": "uuid"},
        "router": {"type": "boolean"},
        "device": {"enum": ["server", "workstation", "virtual_machine", "hypervisor", "router", "switch", "unknown"]}
      },
      "required": ["id", "kind", "label"],
      "additionalProperties": false
    },
    "Link": {
      "type": "object",
      "properties": {
        "a": {"type": "string", "maxLength": 200},
        "b": {"type": "string", "maxLength": 200},
        "role": {"enum": ["gateway"]},
        "layer": {"enum": ["L2", "L3"]},
        "confidence": {"enum": ["confirmed", "probable", "weak"]},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {
          "type": "object",
          "properties": {
            "source": {"enum": ["interface-address", "route", "lldp", "fdb", "ip-subnet"]},
            "detail": {"type": "string", "maxLength": 400},
            "origin": {"type": "string", "format": "uuid"}
          },
          "required": ["source", "detail"],
          "additionalProperties": false
        }},
        "conflicts": {"type": "array", "maxItems": 100, "items": {"type": "string", "maxLength": 300}}
      },
      "required": ["a", "b", "layer", "confidence", "evidence"],
      "additionalProperties": false
    }
  }
}

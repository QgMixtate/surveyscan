[Unit]
Description=SurveyScan read-only Linux host agent
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/surveyscan-agent/agent.json

[Service]
Type=simple
User=surveyscan-agent
Group=surveyscan-agent
ExecStart=/usr/local/bin/surveyscan-agent run --config /etc/surveyscan-agent/agent.json
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
StateDirectory=surveyscan-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/surveyscan-agent

[Install]
WantedBy=multi-user.target

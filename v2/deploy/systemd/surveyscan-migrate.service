[Unit]
Description=SurveyScan PostgreSQL schema migration (before server)
Wants=network-online.target
Requires=postgresql.service
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=surveyscan-server
Group=surveyscan-server
LoadCredential=pg_password:/etc/surveyscan-server/pg_password
EnvironmentFile=/etc/surveyscan-server/server.env
Environment=SURVEYSCAN_V2_DATABASE_PASSWORD_FILE=%d/pg_password
ExecStart=/opt/surveyscan/current/bin/surveyscan-server migrate
RemainAfterExit=yes
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

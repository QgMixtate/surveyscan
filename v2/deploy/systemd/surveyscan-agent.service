[Unit]
Description=SurveyScan agent (Linux E1)
ConditionPathExists=!/opt/surveyscan/update.fence
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=surveyscan-agent
Group=surveyscan-agent
StateDirectory=surveyscan-agent
StateDirectoryMode=0700
LoadCredential=config:/etc/surveyscan-agent/config.json
ExecStart=/opt/surveyscan/current/bin/surveyscan-agent run --config %d/config
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

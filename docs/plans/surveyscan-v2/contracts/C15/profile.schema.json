{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:surveyscan:c15:inventory-profile:1:2",
  "$defs": {
    "Revision": {
      "type": "object",
      "properties": {
        "common_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "policy_id": {
          "const": "windows-amd64-partial-baseline-v1"
        }
      },
      "required": [
        "common_revision",
        "policy_id"
      ],
      "additionalProperties": false
    },
    "Config": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "format": "uuid"
        },
        "collector_id": {
          "type": "string",
          "format": "uuid"
        },
        "profile_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "policy_id": {
          "const": "windows-amd64-partial-baseline-v1"
        },
        "platform": {
          "const": "windows/amd64"
        },
        "sections": {
          "type": "array",
          "items": {
            "enum": [
              "identity",
              "os",
              "network",
              "hardware",
              "software",
              "updates",
              "services",
              "users_groups",
              "routes_ports",
              "resources",
              "protection",
              "neighbors"
            ]
          },
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true
        },
        "heartbeat_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "inventory_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "jitter_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 25
        },
        "spool_limit_bytes": {
          "type": "integer",
          "minimum": 524288,
          "maximum": 1073741824
        },
        "worker_timeout_seconds": {
          "const": 30
        },
        "collection_timeout_seconds": {
          "const": 420
        },
        "snapshot_mode": {
          "const": "partial"
        },
        "observation_version": {
          "type": "object",
          "properties": {
            "major": {
              "const": 1
            },
            "minor": {
              "const": 2
            }
          },
          "required": [
            "major",
            "minor"
          ],
          "additionalProperties": false
        },
        "batch_version": {
          "type": "object",
          "properties": {
            "major": {
              "const": 1
            },
            "minor": {
              "const": 2
            }
          },
          "required": [
            "major",
            "minor"
          ],
          "additionalProperties": false
        },
        "inventory12_limits": {
          "type": "object",
          "properties": {
            "canonical_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 524288
            },
            "signed_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 589824
            },
            "batch_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 786432
            },
            "max_records": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": [
            "canonical_bytes",
            "signed_bytes",
            "batch_bytes",
            "max_records"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source_id",
        "collector_id",
        "profile_revision",
        "policy_id",
        "platform",
        "sections",
        "heartbeat_seconds",
        "inventory_seconds",
        "jitter_percent",
        "spool_limit_bytes",
        "worker_timeout_seconds",
        "collection_timeout_seconds",
        "snapshot_mode",
        "observation_version",
        "batch_version",
        "inventory12_limits"
      ],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "object",
          "properties": {
            "major": {
              "const": 1
            },
            "minor": {
              "const": 2
            }
          },
          "required": [
            "major",
            "minor"
          ],
          "additionalProperties": false
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_kind": {
              "const": "agent"
            },
            "generation_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "source_id",
            "source_kind",
            "generation_id"
          ],
          "additionalProperties": false
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "platform": {
          "const": "windows/amd64"
        },
        "applied": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Revision"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "tenant_id",
        "origin",
        "nonce",
        "sent_at",
        "platform",
        "applied"
      ],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "object",
          "properties": {
            "major": {
              "const": 1
            },
            "minor": {
              "const": 2
            }
          },
          "required": [
            "major",
            "minor"
          ],
          "additionalProperties": false
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "format": "uuid"
            },
            "source_kind": {
              "const": "agent"
            },
            "generation_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "source_id",
            "source_kind",
            "generation_id"
          ],
          "additionalProperties": false
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "managed": {
          "type": "boolean"
        },
        "config": {
          "$ref": "#/$defs/Config"
        }
      },
      "required": [
        "schema_version",
        "tenant_id",
        "origin",
        "nonce",
        "issued_at",
        "expires_at",
        "managed",
        "config"
      ],
      "additionalProperties": false
    },
    "SignedRequest": {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/Request"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key_id": {
          "type": "string",
          "format": "uuid"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": [
        "payload",
        "digest",
        "key_id",
        "signature"
      ],
      "additionalProperties": false
    },
    "SignedResponse": {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/Response"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key_id": {
          "type": "string",
          "format": "uuid"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": [
        "payload",
        "digest",
        "key_id",
        "signature"
      ],
      "additionalProperties": false
    }
  }
}
